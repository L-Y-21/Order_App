        public async Task<List<Item>> SearchItemsAsync(string? query = null, int? categoryId = null, bool activeOnly = true, int limit = 50)
        {
            var items = new List<Item>();
            var sql = @"
                SELECT TOP (@limit) i.*, c.name AS category_name, u.code AS base_uom_code, t.rate_percent, t.tax_type
                FROM items i
                LEFT JOIN categories c ON c.id = i.category_id
                LEFT JOIN uom u ON u.id = i.base_uom_id
                LEFT JOIN tax_rates t ON t.id = i.tax_rate_id
                WHERE 1=1";

            if (!string.IsNullOrEmpty(query))
            {
                sql += " AND (i.name LIKE @query OR i.sku LIKE @query)";
            }
            if (categoryId.HasValue)
            {
                sql += " AND i.category_id = @category_id";
            }
            if (activeOnly)
            {
                sql += " AND i.is_active = 1";
            }

            sql += " ORDER BY i.name";

            if (_connection == null) throw new InvalidOperationException("Connection is not initialized.");
            using var cmd = _connection.CreateCommand();
            cmd.CommandText = sql;

            if (!string.IsNullOrEmpty(query))
            {
                cmd.Parameters.AddWithValue("@query", $"%{query}%");
            }
            if (categoryId.HasValue)
            {
                cmd.Parameters.AddWithValue("@category_id", categoryId.Value);
            }
            cmd.Parameters.AddWithValue("@limit", limit);

            using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                items.Add(MapItemFromReader(reader));
            }

            return items;
        }

