        private async Task<string> GenerateOrderNumberAsync()
        {
            var year = DateTime.Now.Year;
            if (_connection == null) throw new InvalidOperationException("Connection is not initialized.");
            using var cmd = _connection.CreateCommand();
            cmd.CommandText = "SELECT COUNT(*) as cnt FROM orders WHERE order_number LIKE @pattern";
            cmd.Parameters.AddWithValue("@pattern", $"ORD-{year}-%");

            var result = await cmd.ExecuteScalarAsync();
            var count = Convert.ToInt32(result);
            var seq = (count + 1).ToString().PadLeft(6, '0');
            return $"ORD-{year}-{seq}";
        }

