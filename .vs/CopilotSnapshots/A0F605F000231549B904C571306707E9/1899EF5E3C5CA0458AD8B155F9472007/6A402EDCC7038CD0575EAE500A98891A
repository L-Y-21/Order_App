        public async Task<(int OrderId, string OrderNumber)> CreateOrderAsync(Order orderData, List<OrderItem> lineItems)
        {
            var orderNumber = await GenerateOrderNumberAsync();

            if (_connection == null) throw new InvalidOperationException("Connection is not initialized.");
            using var transaction = (SqlTransaction)await _connection.BeginTransactionAsync();
            try
            {
                using var cmd = _connection.CreateCommand();
                cmd.Transaction = transaction;
                cmd.CommandText = @"
                    INSERT INTO orders (order_number, customer_id, customer_name_snapshot, customer_phone_snapshot, customer_address_snapshot,
                        status, subtotal, tax_amount, discount_amount, total_amount, voucher_id, voucher_code_snapshot, notes, created_by, fs)
                    VALUES (@order_number, @customer_id, @customer_name_snapshot, @customer_phone_snapshot, @customer_address_snapshot,
                        @status, @subtotal, @tax_amount, @discount_amount, @total_amount, @voucher_id, @voucher_code_snapshot, @notes, @created_by, @fs);
                    SELECT SCOPE_IDENTITY();";
                
                cmd.Parameters.AddWithValue("@order_number", orderNumber);
                cmd.Parameters.AddWithValue("@customer_id", orderData.CustomerId ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@customer_name_snapshot", orderData.CustomerNameSnapshot ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@customer_phone_snapshot", orderData.CustomerPhoneSnapshot ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@customer_address_snapshot", orderData.CustomerAddressSnapshot ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@status", orderData.Status);
                cmd.Parameters.AddWithValue("@subtotal", orderData.Subtotal);
                cmd.Parameters.AddWithValue("@tax_amount", orderData.TaxAmount);
                cmd.Parameters.AddWithValue("@discount_amount", orderData.DiscountAmount);
                cmd.Parameters.AddWithValue("@total_amount", orderData.TotalAmount);
                cmd.Parameters.AddWithValue("@voucher_id", orderData.VoucherId ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@voucher_code_snapshot", orderData.VoucherCodeSnapshot ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@notes", orderData.Notes ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@created_by", orderData.CreatedBy ?? (object)DBNull.Value);
                cmd.Parameters.AddWithValue("@fs", orderData.Fs ?? (object)DBNull.Value);

                var result = await cmd.ExecuteScalarAsync();
                var orderId = Convert.ToInt32(result);

                // Insert line items
                for (int i = 0; i < lineItems.Count; i++)
                {
                    using var itemCmd = _connection.CreateCommand();
                    itemCmd.Transaction = transaction;
                    itemCmd.CommandText = @"
                        INSERT INTO order_items (order_id, item_id, item_name_snapshot, item_sku_snapshot, uom_snapshot,
                            unit_price_snapshot, tax_rate_snapshot, tax_type_snapshot, quantity, line_subtotal, line_tax_amount,
                            line_discount_amount, line_total, sort_order)
                        VALUES (@order_id, @item_id, @item_name_snapshot, @item_sku_snapshot, @uom_snapshot,
                            @unit_price_snapshot, @tax_rate_snapshot, @tax_type_snapshot, @quantity, @line_subtotal, @line_tax_amount,
                            @line_discount_amount, @line_total, @sort_order)";
                    
                    var item = lineItems[i];
                    itemCmd.Parameters.AddWithValue("@order_id", orderId);
                    itemCmd.Parameters.AddWithValue("@item_id", item.ItemId ?? (object)DBNull.Value);
                    itemCmd.Parameters.AddWithValue("@item_name_snapshot", item.ItemNameSnapshot);
                    itemCmd.Parameters.AddWithValue("@item_sku_snapshot", item.ItemSkuSnapshot ?? (object)DBNull.Value);
                    itemCmd.Parameters.AddWithValue("@uom_snapshot", item.UomSnapshot);
                    itemCmd.Parameters.AddWithValue("@unit_price_snapshot", item.UnitPriceSnapshot);
                    itemCmd.Parameters.AddWithValue("@tax_rate_snapshot", item.TaxRateSnapshot);
                    itemCmd.Parameters.AddWithValue("@tax_type_snapshot", item.TaxTypeSnapshot);
                    itemCmd.Parameters.AddWithValue("@quantity", item.Quantity);
                    itemCmd.Parameters.AddWithValue("@line_subtotal", item.LineSubtotal);
                    itemCmd.Parameters.AddWithValue("@line_tax_amount", item.LineTaxAmount);
                    itemCmd.Parameters.AddWithValue("@line_discount_amount", item.LineDiscountAmount);
                    itemCmd.Parameters.AddWithValue("@line_total", item.LineTotal);
                    itemCmd.Parameters.AddWithValue("@sort_order", i);
                    await itemCmd.ExecuteNonQueryAsync();
                }

                await transaction.CommitAsync();
                return (orderId, orderNumber);
            }
            catch
            {
                await transaction.RollbackAsync();
                throw;
            }
        }

