using System.Net.Sockets;
using System.Text;
using OrderApp.Models;

namespace OrderApp.Services
{
    /// <summary>
    /// Sends receipts to a "virtual" or network receipt printer over raw TCP (ESC/POS),
    /// the same protocol real thermal receipt printers (Epson TM-T20/T88, Star, Xprinter, etc.)
    /// use on port 9100 ("JetDirect"/raw printing). Pointing this at 127.0.0.1:9100 lets you
    /// test full receipt output using any local ESC/POS printer emulator/simulator, with no
    /// physical hardware attached, before switching to a real network printer's IP.
    /// </summary>
    public class VirtualPrinterService
    {
        public const int DefaultPort = 9100;
        public const string DefaultHost = "127.0.0.1";
        private const int ConnectTimeoutMs = 2500;

        public async Task<bool> TestConnectionAsync(string host, int port)  
        {
            try
            {
                using var client = new TcpClient();
                var connectTask = client.ConnectAsync(host, port);
                var completed = await Task.WhenAny(connectTask, Task.Delay(ConnectTimeoutMs));
                return completed == connectTask && client.Connected && connectTask.IsCompletedSuccessfully;
            }
            catch
            {
                return false;
            }
        }

        public async Task<(bool Success, string Message)> PrintOrderAsync(Order order, string host, int port, string? operatorName = null)
        {
            try
            {
                using var client = new TcpClient();
                var connectTask = client.ConnectAsync(host, port);
                var completed = await Task.WhenAny(connectTask, Task.Delay(ConnectTimeoutMs));

                if (completed != connectTask || !client.Connected)
                {
                    return (false, $"Could not reach virtual printer at {host}:{port}.\n" +
                                   "Make sure a local ESC/POS printer emulator (or your network printer) is listening on that address.");
                }

                var receipt = BuildEscPosReceipt(order, operatorName);
                using var stream = client.GetStream();
                await stream.WriteAsync(receipt, 0, receipt.Length);
                await stream.FlushAsync();

                return (true, $"Receipt sent to virtual printer at {host}:{port}");
            }
            catch (SocketException sockEx)
            {
                return (false, $"Could not connect to {host}:{port} ({sockEx.SocketErrorCode}). Is the virtual printer running?");
            }
            catch (Exception ex)
            {
                return (false, $"Virtual printer error: {ex.Message}");
            }
        }

        /// <summary>
        /// Builds a plain-text ESC/POS byte stream: initialize, centered bold header,
        /// itemized lines, totals, and a paper cut command. Assumes a 32-column (58mm) printer;
        /// widen PadLine's width if you're using an 80mm/42-column printer.
        /// </summary>
        public byte[] BuildEscPosReceipt(Order order, string? operatorName = null, int columns = 32)
        {
            var sb = new StringBuilder();
            string PadLine(string text, char padChar = ' ') => text.PadRight(columns, padChar);

            sb.AppendLine(PadLine("Gorgeous Restaurant", ' '));
            sb.AppendLine(PadLine("TIN: 0058922940", ' '));
            sb.AppendLine(PadLine($"Date: {DateTime.Now:yyyy-MM-dd HH:mm}", ' '));
            sb.AppendLine(new string('-', columns));

            foreach (var item in order.Items)
            {
                sb.AppendLine($"{item.ItemNameSnapshot.PadRight(columns - 10)} {item.Quantity,5} {item.LineTotal,10:N2}");
            }

            sb.AppendLine(new string('-', columns));
            sb.AppendLine(PadLine($"Subtotal: {order.Subtotal:N2}", ' '));
            sb.AppendLine(PadLine($"VAT (15%): {order.TaxAmount:N2}", ' '));
            sb.AppendLine(PadLine($"Total: {order.TotalAmount:N2}", ' '));
            sb.AppendLine(new string('-', columns));
            sb.AppendLine(PadLine("Thank you for your purchase!", ' '));

            return Encoding.ASCII.GetBytes(sb.ToString());
        }
    }
}