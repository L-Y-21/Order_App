        private async void MainForm_Load(object sender, EventArgs e)
        {
            try
            {
                _db = new DBManager();
                await _db.ConnectAsync();
                await _db.InitSchemaAsync();

                _orderProcessor = new OrderProcessor(_db);
                _printerManager = new PrinterManager();
                _virtualPrinterService = new VirtualPrinterService();

                await LoadItemsAsync();
                await LoadCustomersForComboAsync();
                await LoadPrintersAsync();
                UpdateCartDisplay();
                UpdateStatus("Ready - Virtual Printer enabled");

                _printerRefreshTimer = new Timer { Interval = 30000 };
                _printerRefreshTimer.Tick += async (s, args) => await LoadPrintersAsync();
                _printerRefreshTimer.Start();

                ShowPosPanel();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error initializing: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                UpdateStatus($"Error: {ex.Message}");
            }
        }

        private async Task LoadCustomersForComboAsync()
        {
            if (_db == null || customerComboBox == null) return;

            try
            {
                _customers = await _db.SearchCustomersAsync();
                customerComboBox.Items.Clear();
                customerComboBox.Items.Add("Walk-in Customer");

                foreach (var customer in _customers)
                {
                    customerComboBox.Items.Add($"{customer.Name} - {customer.Phone}");
                }

                if (customerComboBox.Items.Count > 0)
                {
                    customerComboBox.SelectedIndex = 0;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error loading customers: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

