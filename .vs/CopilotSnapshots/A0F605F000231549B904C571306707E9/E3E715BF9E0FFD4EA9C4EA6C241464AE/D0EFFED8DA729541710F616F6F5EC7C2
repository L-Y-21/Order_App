        private async void printButton_Click(object sender, EventArgs e)
        {
            if (_cart.Count == 0)
            {
                MessageBox.Show("Cart is empty", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // Make customer selection mandatory
            if (customerComboBox == null || customerComboBox.SelectedIndex <= 0)
            {
                MessageBox.Show("Please select a customer before printing. Customer selection is mandatory.", "Customer Required", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                if (customerComboBox != null) customerComboBox.Focus();
                return;
            }

            try
            {
                if (_orderProcessor == null || _db == null || printButton == null) return;

                printButton.Enabled = false;
                printButton.Text = "Processing...";

                // Validate that all items in cart still exist in database
                var allItems = await _db.SearchItemsAsync(limit: 1000);
                var invalidItems = _cart.Where(c => !allItems.Any(i => i.Id == c.ItemId)).ToList();

                if (invalidItems.Any())
                {
                    var invalidItemNames = string.Join(", ", invalidItems.Select(i => i.ItemName));
                    MessageBox.Show($"The following items are no longer available: {invalidItemNames}\nPlease remove them from cart and try again.", "Items Not Found", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                // Get selected customer safely
                string customerName = "Walk-in Customer";
                int? customerId = null;

                if (customerComboBox != null && customerComboBox.SelectedIndex > 0 && customerComboBox.SelectedItem != null)
                {
                    var selected = customerComboBox.SelectedItem.ToString();
                    if (!string.IsNullOrEmpty(selected))
                    {
                        var parts = selected.Split(" - ");
                        if (parts.Length > 0)
                        {
                            customerName = parts[0];
                            var customer = _customers.FirstOrDefault(c => c.Name == parts[0]);
                            if (customer != null)
                            {
                                customerId = customer.Id;
                            }
                        }
                    }
                }

                var subtotal = _cart.Sum(c => c.LineTotal);
                var vat = subtotal * 0.15m;
                var totalAmount = subtotal + vat;

                var lines = _cart.Select(c => (c.ItemId, c.Quantity, 1)).ToList();
                // Auto-set voucher code
                var voucherCode = "VOUCHER-" + DateTime.Now.ToString("yyyyMMddHHmmss");

                // Save order to database first
                var orderMeta = new Order
                {
                    CustomerId = customerId,
                    CustomerNameSnapshot = customerName,
                    Status = "confirmed",
                    Subtotal = subtotal,
                    TaxAmount = vat,
                    TotalAmount = totalAmount,
                    CreatedBy = "System"
                };

                var (orderId, orderNumber, calc) = await _orderProcessor.CreateOrderAsync(orderMeta, lines, voucherCode);

                // Order saved successfully, now print
                printButton.Text = "Printing...";

                var printOrder = new Order
                {
                    OrderNumber = orderNumber,
                    OrderDate = DateTime.Now,
                    CustomerNameSnapshot = customerName,
                    Status = "confirmed",
                    Subtotal = subtotal,
                    TaxAmount = vat,
                    DiscountAmount = 0,
                    TotalAmount = totalAmount,
                    Items = _cart.Select(c => new OrderItem
                    {
                        ItemNameSnapshot = c.ItemName,
                        UomSnapshot = "pcs",
                        Quantity = c.Quantity,
                        UnitPriceSnapshot = c.UnitPrice,
                        LineTotal = c.LineTotal
                    }).ToList()
                };

                // Always use virtual printer (IP-based) first
                var host = string.IsNullOrWhiteSpace(virtualPrinterHostTextBox?.Text) ? VirtualPrinterService.DefaultHost : virtualPrinterHostTextBox!.Text.Trim();
                var port = int.TryParse(virtualPrinterPortTextBox?.Text, out var p) ? p : VirtualPrinterService.DefaultPort;

                if (_virtualPrinterService == null) _virtualPrinterService = new VirtualPrinterService();
                var (printSuccess, printMessage) = await _virtualPrinterService.PrintOrderAsync(printOrder, host, port, _currentUser);

                if (printSuccess)
                {
                    MessageBox.Show($"Order created and printed successfully!\nOrder Number: {orderNumber}\nCustomer: {customerName}\nSubtotal: ETB {subtotal:N2}\nVAT (15%): ETB {vat:N2}\nGrand Total: ETB {totalAmount:N2}\nVoucher Code: {voucherCode}",
                        "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);

                    _cart.Clear();
                    UpdateCartDisplay();
                    await LoadOrdersAsync();

                    // Auto-display attachment for the new order
                    var newOrder = (await _db.ListOrdersAsync()).FirstOrDefault(o => o.OrderNumber == orderNumber);
                    if (newOrder != null)
                    {
                        await ShowOrderAttachmentAsync(newOrder);
                    }
                }
                else
                {
                    // Virtual printer failed, offer Windows print dialog as fallback
                    var result = MessageBox.Show($"Virtual printer connection failed: {printMessage}\n\nWould you like to print using Windows printer dialog instead?\nOrder Number: {orderNumber}",
                        "Print Failed - Use Fallback?", MessageBoxButtons.YesNo, MessageBoxIcon.Question);

                    if (result == DialogResult.Yes)
                    {
                        if (_printerManager == null) _printerManager = new PrinterManager();
                        var (winPrintSuccess, winPrintMessage) = await _printerManager.PrintInvoiceAsync(printOrder, "", _currentUser);

                        if (winPrintSuccess)
                        {
                            MessageBox.Show($"Order created and printed successfully via Windows printer!\nOrder Number: {orderNumber}\nCustomer: {customerName}\nSubtotal: ETB {subtotal:N2}\nVAT (15%): ETB {vat:N2}\nGrand Total: ETB {totalAmount:N2}\nVoucher Code: {voucherCode}",
                                "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);

                            // Auto-display attachment for the new order
                            var newOrder = (await _db.ListOrdersAsync()).FirstOrDefault(o => o.OrderNumber == orderNumber);
                            if (newOrder != null)
                            {
                                await ShowOrderAttachmentAsync(newOrder);
                            }
                        }
                        else
                        {
                            MessageBox.Show($"Order saved but Windows printing also failed: {winPrintMessage}\nOrder Number: {orderNumber}", "Print Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        }
                    }
                    else
                    {
                        MessageBox.Show($"Order saved successfully but printing was cancelled.\nOrder Number: {orderNumber}", "Order Saved", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }

                    // Still clear cart since order was saved
                    _cart.Clear();
                    UpdateCartDisplay();
                    await LoadOrdersAsync();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                if (printButton != null)
                {
                    printButton.Enabled = true;
                    printButton.Text = "🖨️ Print Invoice";
                }
            }
        }

