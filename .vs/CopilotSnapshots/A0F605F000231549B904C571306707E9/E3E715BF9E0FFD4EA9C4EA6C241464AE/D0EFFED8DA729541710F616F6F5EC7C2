        private void UpdateCartDisplay()
        {
            if (cartDataGridView == null) return;

            cartDataGridView.CellClick -= CartDataGridView_CellClick;

            cartDataGridView.DataSource = null;
            cartDataGridView.DataSource = _cart;

            cartDataGridView.AutoGenerateColumns = false;
            cartDataGridView.CellClick += CartDataGridView_CellClick;

            // Update button text based on selection state
            foreach (DataGridViewRow row in cartDataGridView.Rows)
            {
                if (row.DataBoundItem is CartItem cartItem)
                {
                    row.Cells["Selected"].Value = cartItem.Selected ? "☑" : "☐";
                }
            }

            if (itemCountLabel != null)
            {
                var totalItems = _cart.Sum(c => c.Quantity);
                itemCountLabel.Text = $"Items: {totalItems}";
            }

            var subtotal = _cart.Sum(c => c.LineTotal);
            var vat = subtotal * 0.15m;
            var grandTotal = subtotal + vat;

            if (subtotalLabel != null)
                subtotalLabel.Text = $"ETB {subtotal:N2}";
            if (vatLabel != null)
                vatLabel.Text = $"ETB {vat:N2}";
            if (grandTotalLabel != null)
                grandTotalLabel.Text = $"ETB {grandTotal:N2}";
        }
        private void CartDataGridView_CellClick(object? sender, DataGridViewCellEventArgs e)
        {
            // Ensure the click is on a valid data row and column
            if (e.RowIndex < 0 || e.ColumnIndex < 0) return;

            // Ensure the clicked row has a valid CartItem
            if (cartDataGridView?.Rows[e.RowIndex].DataBoundItem is not CartItem cartItem) return;

            // Get the column name to determine the action
            var colName = cartDataGridView.Columns[e.ColumnIndex].Name;

            if (colName == "Selected")
            {
                // Toggle selection
                cartItem.Selected = !cartItem.Selected;
                UpdateCartDisplay();
            }
            else if (colName == "Plus")
            {
                // Increment quantity
                cartItem.Quantity++;
                cartItem.LineTotal = cartItem.Quantity * cartItem.UnitPrice;
                UpdateCartDisplay();
            }
            else if (colName == "Minus")
            {
                // Decrement quantity or remove item if quantity is 1
                if (cartItem.Quantity > 1)
                {
                    cartItem.Quantity--;
                    cartItem.LineTotal = cartItem.Quantity * cartItem.UnitPrice;
                    UpdateCartDisplay();
                }
                else
                {
                    _cart.Remove(cartItem);
                    UpdateCartDisplay();
                }
            }
        }

