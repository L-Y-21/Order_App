        // Applies the current search query and page to the already-fetched order list, then binds the grid.
        // This is purely in-memory so search-as-you-type and pagination stay instant with no DB round-trip.
        private void ApplyOrdersFilterAndDisplay()
        {
            if (ordersDataGridView == null) return;

            var query = _ordersSearchQuery.Trim().ToLower();
            var filtered = string.IsNullOrEmpty(query)
                ? _ordersAll
                : _ordersAll.Where(o =>
                    (o.OrderNumber?.ToLower().Contains(query) ?? false) ||
                    (o.CustomerNameSnapshot?.ToLower().Contains(query) ?? false) ||
                    (o.Status?.ToLower().Contains(query) ?? false) ||
                    (o.VoucherCodeSnapshot?.ToLower().Contains(query) ?? false)).ToList();

            _ordersTotalCount = filtered.Count;

            var totalPages = (int)Math.Ceiling((double)_ordersTotalCount / _ordersPageSize);
            if (_ordersCurrentPage > totalPages && totalPages > 0) _ordersCurrentPage = totalPages;
            if (_ordersCurrentPage < 1) _ordersCurrentPage = 1;

            var skip = (_ordersCurrentPage - 1) * _ordersPageSize;
            _orders = filtered.Skip(skip).Take(_ordersPageSize).ToList();

            ordersDataGridView.DataSource = null;
            ordersDataGridView.DataSource = _orders;

            if (_ordersPageLabel != null)
            {
                _ordersPageLabel.Text = totalPages > 0 ? $"Page {_ordersCurrentPage} of {totalPages} ({_ordersTotalCount} total)" : "No orders";
            }
            if (_ordersPrevButton != null)
            {
                _ordersPrevButton.Enabled = _ordersCurrentPage > 1;
            }
            if (_ordersNextButton != null)
            {
                _ordersNextButton.Enabled = _ordersCurrentPage < totalPages;
            }
        }

