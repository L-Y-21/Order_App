        // Adds one row of text cells into the ruled table panel at the given row index.
        private static void AddTableRow(Panel tablePanel, string[] cells, int[] colWidths, int rowIndex, int rowHeight, bool isHeader)
        {
            int x = 0;
            for (int c = 0; c < cells.Length; c++)
            {
                bool numeric = c >= 2; // Qty, UOM, Unit Amount, Total right-aligned; SN/Description left-aligned
                var lbl = new Label
                {
                    Location = new Point(x + 4, rowIndex * rowHeight),
                    Size = new Size(colWidths[c] - 8, rowHeight),
                    Text = cells[c],
                    Font = new Font("Consolas", 9, isHeader ? FontStyle.Bold : FontStyle.Regular),
                    TextAlign = numeric ? ContentAlignment.MiddleRight : ContentAlignment.MiddleLeft,
                    BackColor = Color.Transparent
                };
                tablePanel.Controls.Add(lbl);
                x += colWidths[c];
            }
        }

        private string NumberToWords(int number)
        {
            if (number == 0) return "Zero";

            string[] ones = { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
            string[] tens = { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

            if (number < 20) return ones[number];
            if (number < 100) return tens[number / 10] + (number % 10 != 0 ? " " + ones[number % 10] : "");
            if (number < 1000) return ones[number / 100] + " Hundred" + (number % 100 != 0 ? " " + NumberToWords(number % 100) : "");
            if (number < 1000000) return NumberToWords(number / 1000) + " Thousand" + (number % 1000 != 0 ? " " + NumberToWords(number % 1000) : "");
            return NumberToWords(number / 1000000) + " Million" + (number % 1000000 != 0 ? " " + NumberToWords(number % 1000000) : "");
        }

