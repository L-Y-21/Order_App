        // Applies a flat, modern, hoverable look to a button.
        private static void StyleButton(Button btn, Color baseColor, Color hoverColor)
        {
            btn.FlatStyle = FlatStyle.Flat;
            btn.FlatAppearance.BorderSize = 0;
            btn.FlatAppearance.MouseOverBackColor = hoverColor;
            btn.FlatAppearance.MouseDownBackColor = ControlPaint.Dark(baseColor, 0.1f);
            btn.BackColor = baseColor;
            btn.ForeColor = Color.White;
            btn.Cursor = Cursors.Hand;
            btn.UseVisualStyleBackColor = false;
        }

        // Configures a DataGridView with a clean, read-only, single-selection look.
        // IMPORTANT: AutoGenerateColumns must be set to false BEFORE DataSource is assigned,
        // otherwise WinForms auto-creates a column for every model property first,
        // and manually-added columns end up duplicated alongside them.
        private static DataGridView CreateStyledGrid(Point location, Size size, Color headerColor)
        {
            var grid = new DataGridView
            {
                Location = location,
                Size = size,
                AutoGenerateColumns = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill,
                ReadOnly = true,
                AllowUserToAddRows = false,
                AllowUserToResizeRows = false,
                MultiSelect = false,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                BackgroundColor = Color.White,
                GridColor = Color.FromArgb(230, 233, 237),
                BorderStyle = BorderStyle.None,
                RowHeadersVisible = false,
                EnableHeadersVisualStyles = false,
                ColumnHeadersHeight = 36,
                ColumnHeadersBorderStyle = DataGridViewHeaderBorderStyle.None,
                CellBorderStyle = DataGridViewCellBorderStyle.SingleHorizontal,
                RowTemplate = { Height = 34 },
                ColumnHeadersDefaultCellStyle =
                {
                    BackColor = headerColor,
                    ForeColor = Color.White,
                    Font = new Font("Segoe UI", 9, FontStyle.Bold),
                    Alignment = DataGridViewContentAlignment.MiddleLeft,
                    Padding = new Padding(6, 0, 0, 0)
                },
                AlternatingRowsDefaultCellStyle =
                {
                    BackColor = Color.FromArgb(247, 249, 251)
                },
                DefaultCellStyle =
                {
                    SelectionBackColor = ControlPaint.Light(headerColor, 0.6f),
                    SelectionForeColor = Color.FromArgb(33, 37, 41),
                    Padding = new Padding(6, 0, 0, 0),
                    Font = new Font("Segoe UI", 9)
                }
            };
            return grid;
        }

