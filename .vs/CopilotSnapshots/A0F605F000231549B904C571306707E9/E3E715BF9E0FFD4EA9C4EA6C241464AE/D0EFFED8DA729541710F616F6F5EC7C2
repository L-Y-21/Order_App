            var nameTextBox = new TextBox { Location = new Point(100, 50), Size = new Size(300, 20), Text = item.Name };

            var priceLabel = new Label { Location = new Point(20, 80), Text = "Price (ETB):", Size = new Size(80, 20) };
            var priceTextBox = new TextBox { Location = new Point(100, 80), Size = new Size(300, 20), Text = item.CurrentPrice.ToString("N2") };

            var stockLabel = new Label { Location = new Point(20, 110), Text = "Stock:", Size = new Size(80, 20) };
            var stockTextBox = new TextBox { Location = new Point(100, 110), Size = new Size(300, 20), Text = item.StockQuantity.ToString("N2") };

            var uomLabel = new Label { Location = new Point(20, 140), Text = "Base UOM ID:", Size = new Size(80, 20) };
            var uomNumeric = new NumericUpDown { Location = new Point(100, 140), Size = new Size(100, 20), Minimum = 1, Maximum = 100, Value = item.BaseUomId };

            var activeLabel = new Label { Location = new Point(20, 170), Text = "Active:", Size = new Size(80, 20) };
            var activeCheckBox = new CheckBox { Location = new Point(100, 170), Size = new Size(100, 20), Checked = item.IsActive };

            var okButton = new Button { Location = new Point(100, 320), Size = new Size(100, 30), Text = "OK", DialogResult = DialogResult.OK };
            var cancelButton = new Button { Location = new Point(220, 320), Size = new Size(100, 30), Text = "Cancel", DialogResult = DialogResult.Cancel };

            form.Controls.AddRange(new Control[] { skuLabel, skuTextBox, nameLabel, nameTextBox, priceLabel, priceTextBox, stockLabel, stockTextBox, uomLabel, uomNumeric, activeLabel, activeCheckBox, okButton, cancelButton });
            form.AcceptButton = okButton;
            form.CancelButton = cancelButton;

            if (form.ShowDialog() == DialogResult.OK)
            {
                if (_db == null) return;

                try
                {
                    item.Sku = skuTextBox.Text;
                    item.Name = nameTextBox.Text;
                    item.CurrentPrice = decimal.TryParse(priceTextBox.Text, out var price) ? price : 0;
                    item.StockQuantity = decimal.TryParse(stockTextBox.Text, out var stock) ? stock : 0;
                    item.BaseUomId = (int)uomNumeric.Value;
                    item.IsActive = activeCheckBox.Checked;

                    await _db.UpdateItemAsync(item);
                    await LoadItemsForManagementAsync();
                    await LoadItemsAsync();
                    MessageBox.Show("Item updated successfully!", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"Error updating item: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }

        private async Task DeleteItemAsync()
        {
            if (itemsManagementDataGridView == null || itemsManagementDataGridView.CurrentRow == null)
