        private async Task AddItemAsync()
        {
            var form = new Form
            {
                Text = "Add New Item",
                Size = new Size(400, 350),
                FormBorderStyle = FormBorderStyle.FixedDialog,
                StartPosition = FormStartPosition.CenterParent
            };

            var skuLabel = new Label { Location = new Point(20, 20), Text = "SKU:", Size = new Size(80, 20) };
            var skuTextBox = new TextBox { Location = new Point(100, 20), Size = new Size(250, 20) };

            var nameLabel = new Label { Location = new Point(20, 50), Text = "Name:", Size = new Size(80, 20) };
            var nameTextBox = new TextBox { Location = new Point(100, 50), Size = new Size(250, 20) };

            var priceLabel = new Label { Location = new Point(20, 80), Text = "Price (ETB):", Size = new Size(80, 20) };
            var priceTextBox = new TextBox { Location = new Point(100, 80), Size = new Size(250, 20) };

            var stockLabel = new Label { Location = new Point(20, 110), Text = "Stock:", Size = new Size(80, 20) };
            var stockTextBox = new TextBox { Location = new Point(100, 110), Size = new Size(250, 20) };

            var okButton = new Button { Location = new Point(100, 250), Size = new Size(80, 30), Text = "OK", DialogResult = DialogResult.OK };
            var cancelButton = new Button { Location = new Point(200, 250), Size = new Size(80, 30), Text = "Cancel", DialogResult = DialogResult.Cancel };

            form.Controls.AddRange(new Control[] { skuLabel, skuTextBox, nameLabel, nameTextBox, priceLabel, priceTextBox, stockLabel, stockTextBox, okButton, cancelButton });
            form.AcceptButton = okButton;
            form.CancelButton = cancelButton;

            if (form.ShowDialog() == DialogResult.OK)
            {
                if (_db == null) return;

                try
                {
                    var item = new Item
                    {
                        Sku = skuTextBox.Text,
                        Name = nameTextBox.Text,
                        CurrentPrice = decimal.TryParse(priceTextBox.Text, out var price) ? price : 0,
                        StockQuantity = decimal.TryParse(stockTextBox.Text, out var stock) ? stock : 0,
                        BaseUomId = 1,
                        IsActive = true
                    };

                    await _db.CreateItemAsync(item);
                    await LoadItemsForManagementAsync();
                    await LoadItemsAsync();
                    MessageBox.Show("Item added successfully!", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
                catch (Exception ex)
                {
                    MessageBox.Show($"Error adding item: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                }
            }
        }

